# Root ignores for PFE_Dahsboard master repository

# Node dependencies
**/node_modules/

# Build outputs
**/dist/
**/dist-ssr/
**/build/
**/.cache/

# Environment and secrets
**/.env
**/.env.*
!.env.example

# Logs
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# IDE/editor files
.vscode/
.idea/
**/.DS_Store
**/*.suo
**/*.njsproj
**/*.sln
**/*.swp
