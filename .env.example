# Copy this file to `.env` in the same directory as `docker-compose.prod.yml`, then fill in secrets.
#   cp .env.example .env
#
# Docker Compose reads `.env` automatically for variable substitution.

# --- MariaDB (service `db`) ---
# Strong passwords recommended. These are also used by the backend to connect.
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=pfe
MYSQL_USER=pfe_app
MYSQL_PASSWORD=change-me-app-password

# --- Backend ---
# Must be at least 32 characters (enforced by pfe-backend).
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Optional: browser origin(s) for CORS when calling the API on port 3000 directly.
# Default in compose is `*`. For a stricter setup use e.g. http://192.168.1.50
# CORS_ORIGIN=*
