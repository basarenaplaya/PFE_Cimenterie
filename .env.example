# =============================================================================
# ONE file for this repo: copy to `.env` next to `docker-compose.prod.yml`
#   cp .env.example .env
#
# • Docker Compose reads this for MariaDB + variable substitution.
# • The backend loads this same file automatically (repo root), including PLC_* and JWT.
# • Docker overrides only DB_HOST / DB_USER / DB_PASSWORD / DB_NAME / PORT / NODE_ENV
#   for the `backend` service — see `docker-compose.prod.yml`.
# • Optional: keep a `pfe-backend/.env` only if you want extra local-only overrides
#   (keys missing from this file are filled from there).
# =============================================================================

# --- MariaDB (Docker service `db` + backend credentials in containers) ---
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=pfe_cement_db
MYSQL_USER=pfe_app
MYSQL_PASSWORD=change-me-app-password

# --- First-time Docker database ---
# SQL in `pfe-backend/db/init/` runs ONLY when the MariaDB volume is empty (first `up`).
# Default login after init: username `admin` / password `ChangeMe!2026` — change it after first login.
# To re-run init scripts: `docker compose -f docker-compose.prod.yml down -v` (deletes all DB data).

# --- Backend: DB when running Node on your PC (not inside Docker) ---
# Use localhost / 127.0.0.1. In Docker, compose forces DB_HOST=db and DB_* from MYSQL_* above.
DB_HOST=localhost
DB_PORT=3306
# Leave these unset if you prefer a single source of truth — then MYSQL_* is used everywhere.
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=pfe_cement_db

PORT=5000
NODE_ENV=development
BIND_HOST=0.0.0.0

# Must be at least 32 characters.
JWT_SECRET=pfe_backend_super_secure_secret_2026_minimum_32_chars
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# Dev dashboard: http://localhost:5173  |  Docker UI: http://localhost (or *)
CORS_ORIGIN=http://localhost:5173

# PLC / S7 (change IP and timing per machine — no Docker override, this file is the source)
PLC_SIMULATOR=false
PLC_IP=192.168.1.11
PLC_PORT=102
PLC_RACK=0
PLC_SLOT=1
PLC_POLL_INTERVAL_MS=500
PLC_RECONNECT_BACKOFF_MS=5000
PLC_SIM_TARGET_MIN=49.5
PLC_SIM_TARGET_MAX=50.5

DB_CONNECTION_LIMIT=10
PRICE_PER_TON_TND=250

# --- Frontend (Vite) local dev only — NOT used by `docker compose` build ---
# If you run `npm run dev` in pfe-dashboard, you can copy these lines to
# pfe-dashboard/.env.development or set them there instead.
# VITE_API_PROXY_TARGET=http://127.0.0.1:5000
